POSTGRES_PASSWORD=troque-isto
# seed Ed25519 de 32 bytes em base64: openssl rand -base64 32
AUTH_SIGNING_KEY=
# login Google (vazio = desligado)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# PoGo Coordinates pelo servidor: chave AES-256 dos tokens, 32 bytes em base64 (openssl rand -base64 32);
# vazio = desligado (/v1/pogo/* responde 503). Trocar a chave invalida todos os vínculos.
POGO_TOKEN_KEY=
# Alertas do PoGo: POGO_WORKERS = usuários atendidos em paralelo por instância (1–64, padrão 32) e
# POGO_ALERT_INTERVAL = de quanto em quanto tempo cada usuário roda (2m–10m, padrão 3m); fora disso a subida falha.
# Capacidade ≈ workers × intervalo / latência, por regra. O PoGo leva 5–15 s por chamada (~7 s típico): com 32 e 3m,
# ≈850 usuários com 1 alerta (≈85 com 10), ≈380 se o PoGo ficar em 15 s; com 64, ≈1.650. Mais workers = mais pressão
# no PoGo; intervalo maior = mais usuários, alerta mais tardio.
# POGO_WORKERS=32
# POGO_ALERT_INTERVAL=3m
# FCM_CREDENTIALS: CAMINHO do JSON da conta de serviço dentro do container, não o conteúdo; vazio = push falso.
# Em produção quem define é o deploy/compose.prod.yml, que monta o arquivo de FCM_CREDENTIALS_FILE (caminho na VM).
# FCM_CREDENTIALS=
# LIBSIGNAL_DIR=../pokelocation-social/tools/libsignal/out/0.86.5
# GOMEMLIMIT=1GiB  (~70% da RAM do container; abaixo do pico vivo o GC roda sem parar)

# Produção (deploy/README.md):
# COMPOSE_FILE=docker-compose.yml:deploy/compose.prod.yml
# PUBLIC_URL=https://pokelocation.waveplay.xyz
# FCM_CREDENTIALS_FILE=/home/<usuário>/pokelocation-secrets/fcm-service-account.json
# GOMEMLIMIT=2GiB
# PAR de escrita do bucket, termina em /o/, sem aspas; vazio = backup desligado
# BACKUP_PAR_URL=
