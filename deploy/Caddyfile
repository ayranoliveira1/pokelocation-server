{
	# log de erro (502 no deploy) sem IP nem URI: a URI leva até o code do callback do Google (deploy/site/privacy.html)
	log default {
		format filter {
			request>remote_ip delete
			request>remote_port delete
			request>client_ip delete
			request>uri delete
		}
	}
}

{$SITE_ADDRESS} {
	# /static/libsignal-<versão>/libsignal_jni-<abi>.so.gz: arquivos imutáveis, com Range (retomada do download).
	# Sem encode: o app pede bytes crus (Accept-Encoding: identity) e o .gz já é comprimido.
	handle_path /static/* {
		root * /srv/static
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle /privacy {
		root * /srv/site
		rewrite * /privacy.html
		file_server
	}
	handle {
		reverse_proxy server:8080
	}
}
